# Puerto del servidor local
PORT=3000

# Genera un valor aleatorio de al menos 32 bytes; no reutilices una clave de ejemplo
JWT_SECRET=

# Supabase (Project Settings -> API). La clave service_role solo se usa en el backend.
# Sin estas variables, el almacenamiento local se usa únicamente fuera de producción.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

